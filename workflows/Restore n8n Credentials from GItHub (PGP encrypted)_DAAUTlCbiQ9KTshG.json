    {
      "id": "78c69955-5de7-4327-b5d1-76ed01c381a4",
      "name": "Sticky Note2",
      "parameters": {
        "color": 3,
        "content": "## Restore from GitHub \nThis workflow will restore/import given credentials from GitHub backups.\n\n\n\n",
        "height": 120,
        "width": 320
      },
      "position": [
        700,
        2160
      ],
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1

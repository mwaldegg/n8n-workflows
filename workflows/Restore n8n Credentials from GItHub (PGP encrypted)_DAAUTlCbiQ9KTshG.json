        },
        "repository": {
          "__rl": true,
          "mode": "url",
          "value": "=https://github.com/{{ $('Globals').item.json.repo.owner }}/{{ $('Globals').item.json.repo.name }}"
        },
        "resource": "file"
      },
      "position": [

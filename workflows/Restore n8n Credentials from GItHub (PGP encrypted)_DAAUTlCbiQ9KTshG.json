  "id": "DAAUTlCbiQ9KTshG",
  "name": "Restore n8n Credentials from GItHub (PGP encrypted)",
  "nodes": [
    {
      "id": "6a9d043e-6097-4917-ba3e-9dc92085ed7b",
      "name": "Sticky Note1",
      "parameters": {
        "color": 4,
        "content": "## Restore n8n Credentials from GitHub  (PGP encrypted) \n\nThis workflow restores or imports credentials from GitHub that were previously generated by my workflow.**Backup n8n Credentials to GitHub (PGP encrypted)**.\n\nThe files are loaded from the specified repository and path (see setup).\n\n**Back it up… or pack it up.**\n\nMWa 2025",
        "height": 437,
        "width": 365
      },
      "position": [
        700,
        1140
      ],
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1
    },
    {
      "credentials": {
        "githubApi": {
          "name": "GitHub (n8n-backup)"
        }
      },
      "id": "0cfbeaf0-c2ea-46d9-9387-ecebd9881452",
      "name": "Get all files in given path",
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {},
        "url": "=https://api.github.com/repos/{{ $json.repo.owner }}/{{ $json.repo.name }}/contents/{{ $json.repo.path }}"
      },
      "position": [
        920,
        1720
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "alwaysOutputData": true,
      "credentials": {
        "githubApi": {
          "name": "GitHub (n8n-backup)"
        }
      },
      "id": "454eed2e-60dd-4cc6-a512-f2b99dc88702",
      "name": "Get file content from GitHub",
      "parameters": {
        "additionalParameters": {},
        "filePath": "={{ $json.Credential }}",
        "operation": "get",
        "owner": {
          "__rl": true,
          "mode": "url",

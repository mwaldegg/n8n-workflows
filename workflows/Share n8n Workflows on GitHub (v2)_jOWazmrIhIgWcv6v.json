    {
      "id": "9f754434-d53d-4044-b53e-9afb5d42849b",
      "name": "Plan Sync",
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst listing = $('List Repo Folder').first().json;\nconst basePath = String(cfg.path).replace(/^\\/+|\\/+$/g, '');\n\nconst workflows = $('Get Shared Workflows').all()\n  .map(i => i.json)\n  .filter(w => w && w.id && !w.isArchived);\n\n// Safety net: never treat an empty result as \"delete everything\"\nif (workflows.length === 0) {\n  throw new Error('No workflows tagged \"' + cfg.tag + '\" found - aborting instead of deleting all files.');\n}\n\n// 404 = folder does not exist yet; anything else that is not 200 is a real error\nlet repoFiles = [];\nif (listing.statusCode === 200) {\n  repoFiles = Array.isArray(listing.body) ? listing.body : [];\n} else if (listing.statusCode !== 404) {\n  throw new Error('Listing ' + basePath + ' failed: HTTP ' + listing.statusCode + ' ' + JSON.stringify(listing.body).slice(0, 300));\n}\nrepoFiles = repoFiles.filter(f => f.type === 'file' && f.name.endsWith('.json'));\n\nconst sortKeys = v => {\n  if (Array.isArray(v)) return v.map(sortKeys);\n  if (v && typeof v === 'object') {\n    const out = {};\n    for (const k of Object.keys(v).sort()) out[k] = sortKeys(v[k]);\n    return out;\n  }\n  return v;\n};\n\n// Only publish what is needed to import the workflow: no pinData, staticData,\n// sharing/project info, version metadata or credential IDs\nconst clean = w => {\n  const settings = Object.assign({}, w.settings || {});\n  delete settings.errorWorkflow;\n  return sortKeys({\n    id: w.id,\n    name: w.name,\n    nodes: (w.nodes || []).map(n => {\n      const copy = Object.assign({}, n);\n      if (copy.credentials) {\n        const creds = {};\n        for (const k of Object.keys(copy.credentials)) creds[k] = { name: copy.credentials[k].name };\n        copy.credentials = creds;\n      }\n      return copy;\n    }),\n    connections: w.connections || {},\n    settings,\n    tags: (w.tags || []).map(t => ({ name: t.name })).sort((a, b) => a.name.localeCompare(b.name)),\n  });\n};\n\nconst safeName = name => String(name)\n  .replace(/[\\\\/:*?\"<>|\\u0000-\\u001f]/g, '-')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst encodePath = p => p.split('/').map(encodeURIComponent).join('/');\n\nconst existing = {};\nfor (const f of repoFiles) existing[f.path] = f;\n\nconst out = [];\nconst wanted = new Set();\nfor (const w of workflows) {\n  const path = basePath + '/' + safeName(w.name) + '_' + w.id + '.json';\n  wanted.add(path);\n  const action = existing[path] ? 'check' : 'create';\n  out.push({ json: {\n    action,\n    id: w.id,\n    name: w.name,\n    path,\n    apiPath: encodePath(path),\n    content: JSON.stringify(clean(w), null, 2),\n    commitMessage: (action === 'create' ? 'add' : 'update') + ': ' + w.name + ' (' + w.id + ')',\n  } });\n}\n\nconst deletes = repoFiles.filter(f => !wanted.has(f.path));\nif (deletes.length > cfg.maxDeletes) {\n  throw new Error(deletes.length + ' files would be deleted (limit ' + cfg.maxDeletes + '): ' + deletes.map(f => f.name).join(', ') + '. Raise maxDeletes in Config if intended.');\n}\nfor (const f of deletes) {\n  out.push({ json: { action: 'delete', name: f.name, path: f.path, commitMessage: 'remove: ' + f.name } });\n}\n\nreturn out;"
      },
      "position": [
        -240,
        112
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
